# ════════════════════════════════════════════════════════════════════════════
# StartupWeek OS — variables d'environnement
# Copier en `.env.local` (dev) ou les saisir dans Vercel → Project → Settings →
# Environment Variables. Ne JAMAIS committer de valeurs réelles.
# Les variables préfixées NEXT_PUBLIC_ sont envoyées au navigateur : jamais de secret dedans.
# ════════════════════════════════════════════════════════════════════════════

# ─── Mode de données de l'interface ───
# demo     : données de démonstration dans le navigateur (localStorage), aucune écriture distante.
# supabase : connexion par lien magique (Supabase Auth) ; le back-office lit/écrit le schéma `crm`
#            avec la session de l'utilisateur (RLS). Réglages Supabase requis : docs/SUPABASE.md § 3.2.
#            Variable intégrée au build : redéployer après modification.
NEXT_PUBLIC_CRM_DATA_MODE=demo

# ─── Supabase ───
# URL du projet (Dashboard → Project Settings → API). Lue par le navigateur ET par le serveur.
NEXT_PUBLIC_SUPABASE_URL=
# Clé publiable (sb_publishable_… ou ancienne clé « anon »). Sûre côté navigateur : la RLS protège les données.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optionnel : URL côté serveur si différente (sinon NEXT_PUBLIC_SUPABASE_URL est utilisée).
SUPABASE_URL=
# Clé SECRÈTE (sb_secret_… ou ancienne clé « service_role ») — serveur uniquement, contourne la RLS.
# Absente → les routes /api/* fonctionnent en mode démo (dry-run, aucune écriture).
SUPABASE_SECRET_KEY=

# ─── Formulaires du site (POST /api/intake/<form>) ───
# Secret partagé avec le site : le site signe le corps brut, en-tête `x-sw-signature: sha256=<hex>`.
# Défini → signature OBLIGATOIRE. Générer avec : openssl rand -hex 32
INTAKE_SIGNING_SECRET=
# Origines navigateur autorisées (CORS), séparées par des virgules. Défaut : https://www.startupweek.tech
ALLOWED_ORIGINS=

# ─── Stripe ───
# Secret de signature de l'endpoint webhook (whsec_…), Dashboard Stripe → Developers → Webhooks.
STRIPE_WEBHOOK_SECRET=
# Clé API (sk_… ou restreinte rk_…) : lecture PaymentIntents / Charges (frais Stripe) et, pour la vente
# des formations Academy, écriture « Checkout Sessions » (POST /api/academy/checkout). Absente → checkout en dry-run.
STRIPE_SECRET_KEY=

# ─── Emails (docs/SUPABASE.md § 5 quater) ───
# Serveur SMTP de la boîte d'envoi (même boîte que n8n : identifiant « smtp-startupweek »).
SMTP_HOST=
# 465 (SSL, par défaut) ou 587 (STARTTLS : mettre SMTP_SECURE=false).
SMTP_PORT=465
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
# Alternative à SMTP : clé API Resend (utilisée seulement si SMTP_HOST est vide).
RESEND_API_KEY=
# Expéditeur, ex. : StartupWeek <contact@startupweek.tech>
EMAIL_FROM=
# Facultatif : adresse de réponse (défaut : l'adresse de EMAIL_FROM) et copie de chaque email envoyé.
EMAIL_REPLY_TO=
EMAIL_BCC=
# Secret de POST /api/emails/dispatch, appelée par la base (pg_net) : même valeur que le secret
# Vault « crm_email_dispatch_secret ». Absent → aucun envoi, les emails restent en file.
EMAIL_DISPATCH_SECRET=
# Facultatif : domaine des liens envoyés par email (documents, désinscription), ex. https://crm.startupweek.tech
PUBLIC_APP_URL=

# ─── Régies publicitaires (POST|GET /api/ads/sync) — lecture seule ───
# Meta : jeton d'un utilisateur système (Business Manager → Utilisateurs système), permission ads_read.
META_ADS_ACCESS_TOKEN=
# Compte publicitaire (« act_1234… » ou « 1234… »).
META_AD_ACCOUNT_ID=
# Optionnel : version de l'API Graph (défaut v25.0).
META_GRAPH_VERSION=
# LinkedIn : jeton OAuth avec les portées r_ads et r_ads_reporting (app LinkedIn « Advertising API »).
# Les jetons LinkedIn expirent (60 jours) : prévoir leur renouvellement.
LINKEDIN_ADS_ACCESS_TOKEN=
# Identifiant numérique du compte publicitaire (Campaign Manager).
LINKEDIN_AD_ACCOUNT_ID=
# Optionnel : version de l'API Marketing, format AAAAMM (défaut 202609 ; une version vit environ un an).
LINKEDIN_API_VERSION=

# ─── Tâches planifiées (Vercel Cron) ───
# Secret des crons : Vercel l'envoie en `Authorization: Bearer <CRON_SECRET>` aux routes planifiées dans vercel.json
# (/api/ads/sync ; le bouton du back-office utilise la session du membre connecté).
CRON_SECRET=

# ─── StartupWeek Academy (e-learning) — docs/ACADEMY.md ───
# Secret partagé avec le site pour l'API apprenant (/api/academy/learner) et le paiement (/api/academy/checkout) :
# corps signé `x-sw-signature: sha256=<hex>` + horodatage `ts`. À défaut, INTAKE_SIGNING_SECRET est utilisé.
# Obligatoire en production (sans secret ni l'autre : 503). Générer avec : openssl rand -hex 32
ACADEMY_API_SECRET=
# Aide à la rédaction des leçons (Claude, /api/academy/ai) : clé API Anthropic, serveur uniquement.
ANTHROPIC_API_KEY=
# Optionnel : modèle utilisé (défaut claude-opus-5).
ACADEMY_AI_MODEL=
# Développement local uniquement : autorise /api/academy/ai sans Supabase (mode démo). Ne jamais définir en production.
ALLOW_DEMO_API=
